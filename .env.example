# Listen port. Defaults to 3847. Railway sets this; do not hardcode it there.
PORT=3847

# Directory for activity.json and trades.json. Defaults to ./data.
# On Railway, mount a volume at /data and set this to /data.
DATA_DIR=./data

# Required. Password for the desk. There is no account system.
DASHBOARD_PASSWORD=

# Optional. Signs the session cookie. When unset, DASHBOARD_PASSWORD signs it.
SESSION_PASSWORD=

# Required for POST /api/ingest. Send it as: Authorization: Bearer <token>
INGEST_TOKEN=

# Optional. Read-only Kraken Futures. Leave blank to show "not connected".
# The server never places, edits, or cancels orders and never moves funds.
KRAKEN_FUTURES_API_KEY=
KRAKEN_FUTURES_API_SECRET=

# Optional. Chat relay to Paperboy. Both must be set, or messages stay on the desk.
# The browser never receives this URL or the key.
ASSISTANT_WEBHOOK_URL=
ASSISTANT_WEBHOOK_KEY=

# Optional. Read-only Kraken spot key (Query Funds). Balance, BalanceEx, and Earn allocations.
# Leave blank to show "Connect spot key".
KRAKEN_SPOT_API_KEY=
KRAKEN_SPOT_API_SECRET=

# Optional. Separate from the read-only futures key. Used only by FORCE STOP:
# cancel all open orders, then close positions with reduce-only market orders.
# Never used for withdrawals or transfers.
KRAKEN_FUTURES_TRADE_API_KEY=
KRAKEN_FUTURES_TRADE_API_SECRET=

# Must be the string true, and the trade keys must be set, or the button stays disarmed.
FORCE_STOP_ENABLED=
